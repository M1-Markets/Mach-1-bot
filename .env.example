# Required
PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY_HERE
SEI_RPC_URL=https://evm-rpc-testnet.sei.io

# Network: sei-testnet (default) or sei-mainnet.
# Only sei-testnet is used by `npx mach1 demo` regardless of this value.
NETWORK=sei-testnet

# Trading mode used by `npx mach1 demo` and example scripts:
#   paper      - paper trading: no real orders, no network calls, no funds at risk (default, safe)
#   simulation - currently behaves the same as paper; reserved for a future "fully fake" path
#   live       - places real orders on the Monaco protocol using PRIVATE_KEY.
#                Demo prints a warning and waits 5s before submitting so you
#                can Ctrl+C to abort.
MODE=paper

# Monaco protocol environment to talk to (which API host).
# This must match where you deposited collateral.
#   staging     - app.m1.markets runs against this today (default)
#   mainnet     - reserved for future production
#   development - early development environment (protocol contributors)
MONACO_ENV=staging
