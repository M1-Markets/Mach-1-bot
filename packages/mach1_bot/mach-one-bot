#!/usr/bin/env node

const { spawn } = require("child_process");
const fs = require("fs");
const path = require("path");

const cliEntryPath = path.join(__dirname, "dist", "cli", "main.js");

if (!fs.existsSync(cliEntryPath)) {
  console.error(`CLI entry not found: ${cliEntryPath}`);
  console.error("Build CLI first with: npm run build:cli");
  process.exit(1);
}

const child = spawn(
  process.execPath,
  [cliEntryPath, ...process.argv.slice(2)],
  {
    cwd: __dirname,
    stdio: "inherit",
  },
);

child.on("error", (error) => {
  console.error("Failed to launch mach-one-bot CLI:", error);
  process.exit(1);
});

child.on("close", (code) => {
  process.exit(code ?? 1);
});
